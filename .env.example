# ==============================================================================
# StarTip Production Environment Variables (Dokploy / VPS Template)
# ==============================================================================

# --- Domains & Routing (Dokploy Traefik) ---
FRONTEND_DOMAIN=startip.app
API_DOMAIN=api.startip.app
DOMAIN=startip.app

# --- Frontend Build Arguments ---
VITE_API_BASE_URL=https://api.startip.app/api
VITE_FRONTEND_URL=https://startip.app
VITE_VPS_IP=

# --- Django Security Settings ---
DJANGO_SETTINGS_MODULE=startip_backend.settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
DJANGO_ALLOWED_HOSTS=startip.app,.startip.app,api.startip.app,.api.startip.app,www.startip.app,localhost,127.0.0.1,web,frontend
CSRF_TRUSTED_ORIGINS=https://startip.app,https://*.startip.app,https://api.startip.app,https://www.startip.app

# --- Database Settings (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=startip_db
POSTGRES_USER=startip_user
POSTGRES_PASSWORD=startip_secret_change_in_production
DATABASE_URL=postgresql://startip_user:startip_secret_change_in_production@db:5432/startip_db

# --- Redis & Celery Settings ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Stellar Network Settings ---
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- OpenAI Services Settings ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App Automation & Seeding ---
RUN_MIGRATIONS=true
SEED_DEMO_DATA=true
